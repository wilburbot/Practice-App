generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String       @id @default(cuid())
  email           String       @unique
  passwordHash    String
  name            String
  createdAt       DateTime     @default(now())
  teams           Team[]
  teamMemberships TeamMember[]
}

model Team {
  id          String       @id @default(cuid())
  name        String
  season      String?
  owner       User         @relation(fields: [ownerId], references: [id])
  ownerId     String
  /// Read-only link token for players/parents — null until the coach first generates one
  shareToken  String?      @unique
  /// Coach invite link token — redeeming it grants full edit access (a TeamMember row), null until generated
  inviteToken String?      @unique
  createdAt   DateTime     @default(now())
  players     Player[]
  sessions    Session[]
  members     TeamMember[]
}

/// An assistant coach with full edit access to a team, added by redeeming the team's invite link.
model TeamMember {
  id        String   @id @default(cuid())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@unique([teamId, userId])
  @@index([userId])
}

model Player {
  id            String      @id @default(cuid())
  team          Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId        String
  firstName     String
  lastName      String
  jerseyNumber  Int?
  position      String?
  active        Boolean     @default(true)
  createdAt     DateTime    @default(now())
  statEvents    StatEvent[]

  @@index([teamId])
}

enum SessionType {
  PRACTICE
  MATCH
  SCRIMMAGE
}

model Session {
  id               String      @id @default(cuid())
  team             Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId           String
  type             SessionType @default(PRACTICE)
  date             DateTime    @default(now())
  opponent         String?
  notes            String?
  videoUrl         String?
  videoDurationSec Float?
  createdAt        DateTime    @default(now())
  statEvents       StatEvent[]

  @@index([teamId])
}

enum ActionType {
  ATTACK
  SERVE
  RECEPTION
  DIG
  BLOCK
  SET
}

enum ActionResult {
  SUCCESS
  ERROR
  ATTEMPT
}

enum ServingTeam {
  OWN
  OPPONENT
}

model StatEvent {
  id                 String       @id @default(cuid())
  session            Session      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId          String
  player             Player       @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId           String
  actionType         ActionType
  result             ActionResult
  /// 0-3 passer rating, only set when actionType is RECEPTION (0 = ace against, 3 = perfect pass)
  passRating         Int?
  /// which team was serving when this happened, used for point-scoring % / side-out %
  servingTeam        ServingTeam?
  setNumber          Int?
  videoTimestampSec  Float?
  createdAt          DateTime     @default(now())

  @@index([sessionId])
  @@index([playerId])
}
