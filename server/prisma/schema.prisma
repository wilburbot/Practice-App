generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String       @id @default(cuid())
  email           String       @unique
  passwordHash    String
  name            String
  createdAt       DateTime     @default(now())
  teams           Team[]
  teamMemberships TeamMember[]
}

model Team {
  id          String       @id @default(cuid())
  name        String
  season      String?
  owner       User         @relation(fields: [ownerId], references: [id])
  ownerId     String
  /// Read-only link token for players/parents — null until the coach first generates one
  shareToken  String?      @unique
  /// Coach invite link token — redeeming it grants full edit access (a TeamMember row), null until generated
  inviteToken String?      @unique
  createdAt   DateTime     @default(now())
  players     Player[]
  sessions    Session[]
  members     TeamMember[]
}

/// An assistant coach with full edit access to a team, added by redeeming the team's invite link.
model TeamMember {
  id        String   @id @default(cuid())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@unique([teamId, userId])
  @@index([userId])
}

model Player {
  id            String      @id @default(cuid())
  team          Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId        String
  firstName     String
  lastName      String
  jerseyNumber  Int?
  position      String?
  active        Boolean     @default(true)
  createdAt     DateTime    @default(now())
  statEvents    StatEvent[]

  @@index([teamId])
}

enum SessionType {
  PRACTICE
  MATCH
  SCRIMMAGE
}

model Session {
  id               String      @id @default(cuid())
  team             Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId           String
  /// Optional coach-given label (e.g. "Serve receive focus") shown instead of the generic type/opponent text
  name             String?
  type             SessionType @default(PRACTICE)
  date             DateTime    @default(now())
  opponent         String?
  notes            String?
  /// Points at the SessionVideo currently being recorded, null when no one is recording. New stat
  /// taps get linked to this clip so they stay tied to the right recording even if the coach starts
  /// and stops recording more than once during one practice (each attempt is its own clip, never
  /// silently overwriting a previous one).
  activeVideoClipId String?
  /// Cached AI-generated recap so it isn't regenerated (and re-billed) on every page view — coach can regenerate
  recapText        String?
  recapGeneratedAt DateTime?
  createdAt        DateTime    @default(now())
  statEvents       StatEvent[]
  videos           SessionVideo[]

  @@index([teamId])
}

/// One recorded video clip within a session. A session can have several — each Start/Stop recording
/// cycle is its own clip — so nothing is lost if a coach records more than once in one practice, and
/// every stat tap stays linked to the specific clip it was tagged during.
model SessionVideo {
  id          String      @id @default(cuid())
  session     Session     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId   String
  /// Null until the recording finishes uploading
  url         String?
  durationSec Float?
  /// Server-authoritative clock start for this clip while it's being recorded — every coach's device
  /// computes a stat tap's videoTimestampSec from this shared reference, so taps logged from
  /// different devices stay in sync with the one video being recorded.
  startedAt   DateTime    @default(now())
  createdAt   DateTime    @default(now())
  statEvents  StatEvent[]

  @@index([sessionId])
}

enum ActionType {
  ATTACK
  SERVE
  RECEPTION
  DIG
  BLOCK
  SET
}

enum ActionResult {
  SUCCESS
  ERROR
  ATTEMPT
}

enum ServingTeam {
  OWN
  OPPONENT
}

model StatEvent {
  id                 String       @id @default(cuid())
  session            Session      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId          String
  player             Player       @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId           String
  actionType         ActionType
  result             ActionResult
  /// 0-3 passer rating, only set when actionType is RECEPTION (0 = ace against, 3 = perfect pass)
  passRating         Int?
  /// which team was serving when this happened, used for point-scoring % / side-out %
  servingTeam        ServingTeam?
  setNumber          Int?
  /// Which recorded clip this tap's videoTimestampSec is relative to — null if no video was recording
  videoClip          SessionVideo? @relation(fields: [videoClipId], references: [id], onDelete: SetNull)
  videoClipId        String?
  videoTimestampSec  Float?
  /// Normalized 0-1 target location on the opponent's court, only set for ATTACK/SERVE, for tendency charts
  targetX            Float?
  targetY            Float?
  createdAt          DateTime     @default(now())

  @@index([sessionId])
  @@index([playerId])
  @@index([videoClipId])
}
