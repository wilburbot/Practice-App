# Local Postgres (see docker-compose.yml at repo root) or a cloud Postgres URL
DATABASE_URL="postgresql://volleyball:volleyball@localhost:5432/volleyball?schema=public"

# Long random string used to sign JWTs — generate with `openssl rand -hex 32`
JWT_SECRET="change-me-to-a-long-random-string"

# Port the API listens on
PORT=4000

# Comma-separated list of origins allowed to call the API (your web app's URL)
CORS_ORIGIN="http://localhost:5173"

# Optional — powers the AI recap/Q&A/coaching-insights features. Get a key at
# https://console.anthropic.com. Without it, those features return a clear
# "not configured" error instead of crashing the server.
ANTHROPIC_API_KEY=""
